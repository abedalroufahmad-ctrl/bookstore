APP_NAME="Book Store API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=book_store
# Set to true only if MongoDB is a replica set (required for transactions)
MONGODB_TRANSACTIONS=false

# JWT
JWT_SECRET=
JWT_TTL=60
# Remember-me access token lifetime in minutes (capped at 30 days in code)
JWT_REMEMBER_TTL=43200
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=0

# CORS (comma-separated origins — do not use * in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Use "debug" only locally; production should use "error" or "warning"
LOG_LEVEL=debug

# Cache & Session (use array/database for API)
CACHE_STORE=file
CACHE_CATALOG_ENABLED=true
CACHE_CATEGORIES_TTL=3600
CACHE_AUTHORS_TTL=3600
CACHE_BOOKS_TTL=900
CACHE_BOOKS_TOTAL_TTL=3600
CATALOG_MAX_OFFSET_PAGE=200
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Queue
QUEUE_CONNECTION=sync

# Broadcast (disabled for API)
BROADCAST_CONNECTION=log

# Filesystem
FILESYSTEM_DISK=local

# Rate limiting (global API throttle uses route middleware; login/checkout have stricter limits)
RATE_LIMIT_PER_MINUTE=60

# PayPal (https://developer.paypal.com — create a REST app for Client ID and Secret)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
# After approval, PayPal redirects here with ?token=PAYPAL_ORDER_ID (must be publicly reachable in sandbox/production)
PAYPAL_RETURN_URL="${APP_URL}/api/v1/paypal/complete"
# Browser redirects after successful capture
PAYPAL_SUCCESS_REDIRECT=http://localhost:5173/orders
PAYPAL_CANCEL_REDIRECT=http://localhost:5173/checkout
# Required for fail-closed PayPal webhook verification
PAYPAL_WEBHOOK_ID=

# Cover OCR (https://ocr.space/ocrapi) — improves Arabic cover text extraction
OCR_SPACE_API_KEY=helloworld

# Stripe (optional card payments)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Production checklist: APP_DEBUG=false, strong APP_KEY + JWT_SECRET, HTTPS CORS origins only.
