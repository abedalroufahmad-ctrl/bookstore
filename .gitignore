# Laravel specific
/api/storage/framework/cache/data/**/*
/api/storage/framework/sessions/*
!/api/storage/framework/sessions/.gitkeep
/api/storage/framework/views/*.php
/api/storage/logs/*.log
/api/storage/app/tessdata/
/api/storage/app/ocr-venv/
/api/.env
/api/vendor/
.phpunit.result.cache
/api/.phpunit.result.cache

# Web app specific
/web/node_modules/
/web/dist/
/web/.env

# IDE & editors
.idea/
*.iml
*.ipr
*.iws

# Local binaries / spreadsheets (not for VCS)
*.appimage
/*.ods
api/app/Console/Commands/*.ods
my-books.ods

# Flutter app — Android build outputs (see also app/.gitignore)
/app/android/build/
/app/android/.gradle/

# General
.DS_Store
.env

# SSH keys (must not be committed)
api/d_ed25519
api/d_ed25519.pub
api/*.pem
api/*.key
