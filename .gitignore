# Laravel specific
/api/storage/framework/cache/data/**/*
/api/storage/framework/sessions/*
!/api/storage/framework/sessions/.gitkeep
/api/storage/framework/views/*.php
/api/storage/logs/*.log
/api/storage/app/tessdata/
/api/storage/app/ocr-venv/
/api/storage/app/public/covers/*
!/api/storage/app/public/covers/.gitkeep
/api/.env
/api/vendor/
/api2/.env
/api2/vendor/
/api2/bootstrap/cache/config.php
/api2/bootstrap/cache/routes-v7.php
/api2/storage/framework/cache/data/**/*
/api2/storage/framework/sessions/*
!/api2/storage/framework/sessions/.gitkeep
/api2/storage/framework/views/*.php
/api2/storage/logs/*.log
/api2/storage/app/tessdata/
/api2/storage/app/ocr-venv/
/api2/storage/app/public/covers/*
!/api2/storage/app/public/covers/.gitkeep
/api2/.phpunit.result.cache
/api2/d_ed25519
/api2/d_ed25519.pub
/api2/*.pem
.phpunit.result.cache
/api/.phpunit.result.cache

# Web app specific
/web/node_modules/
/web/dist/
/web/.env

# IDE & editors
.idea/
*.iml
*.ipr
*.iws

# Local binaries / spreadsheets (not for VCS)
*.appimage
/*.ods
api/app/Console/Commands/*.ods
my-books.ods

# Flutter app — Android build outputs (see also app/.gitignore)
/app/android/build/
/app/android/.gradle/

# Python / tooling caches
__pycache__/
*.pyc
.codacy/
app/devtools_options.yaml

# General
.DS_Store
.env

# MongoDB export includes password hashes
/api2/database/mongodb_data.sql

# SSH keys (must not be committed)
api/d_ed25519
api/d_ed25519.pub
api/*.pem
api/*.key
